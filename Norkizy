-- AUTO WASH 
task.spawn(function()
    while true do
        if cfg.autoWash then
            setStatus("wash", "Scanning...")
            local plot = getPlot()

            if plot then
                local sink = plot:FindFirstChild("Sink")
                local washed = 0

                -- Step 1: Collect dirty dishes
                local collectAreas = {}

                local dp = plot:FindFirstChild("DiningPlot1")
                if dp then
                    table.insert(collectAreas, dp)
                end

                local serve = plot:FindFirstChild("Serve")
                if serve then
                    table.insert(collectAreas, serve)
                end

                for _, area in ipairs(collectAreas) do
                    for _, desc in ipairs(area:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") and desc.Enabled then
                            local action = desc.ActionText:lower()
                            local obj = desc.ObjectText:lower()

                            if string.find(obj, "dirty")
                                or string.find(obj, "dish")
                                or string.find(action, "wash")
                                or string.find(action, "pick") then

                                local pp = desc.Parent

                                if pp and pp:IsA("BasePart") then
                                    local release = acquireTp()

                                    tp(pp.CFrame * CFrame.new(0, 3, 0))
                                    task.wait(0.6)

                                    pcall(function()
                                        if desc.Enabled then
                                            fireproximityprompt(desc)
                                        end
                                    end)

                                    release()
                                    task.wait(0.3)

                                    -- Wait for dish/tool
                                    local gotTool = false

                                    for _ = 1, 20 do
                                        local c = LocalPlayer.Character

                                        if c and c:FindFirstChildOfClass("Tool") then
                                            gotTool = true
                                            break
                                        end

                                        task.wait(0.1)
                                    end

                                    if gotTool and sink then
                                        task.wait(0.15)

                                        -- Find Put prompt
                                        for _, pd in ipairs(sink:GetDescendants()) do
                                            if pd:IsA("ProximityPrompt") and pd.Enabled then
                                                local a = pd.ActionText:lower()

                                                if string.find(a, "put")
                                                    or string.find(a, "place")
                                                    or pd.Name == "Put" then

                                                    local r2 = acquireTp()

                                                    tp(
                                                        pd.Parent.CFrame
                                                        * CFrame.new(0, 3, 0)
                                                    )

                                                    task.wait(0.2)

                                                    pcall(function()
                                                        if pd.Enabled then
                                                            fireproximityprompt(pd)
                                                        end
                                                    end)

                                                    r2()

                                                    task.wait(0.5)
                                                    break
                                                end
                                            end
                                        end
                                    end

                                    -- Drop held dish/tool if necessary
                                    pcall(function()
                                        local c = LocalPlayer.Character

                                        if c then
                                            local t = c:FindFirstChildOfClass("Tool")

                                            if t then
                                                t.Parent = LocalPlayer.Backpack
                                            end
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end

                -- Step 2: Wash dishes
                if sink then
                    for attempt = 1, 20 do
                        local washPrompt = nil

                        -- Find the actual ProximityPrompt directly.
                        -- Camera visibility is NOT required.
                        for _, pd in ipairs(sink:GetDescendants()) do
                            if pd:IsA("ProximityPrompt") and pd.Enabled then
                                local a = pd.ActionText:lower()
                                local o = pd.ObjectText:lower()

                                if string.find(a, "wash")
                                    or string.find(a, "clean")
                                    or string.find(a, "scrub")
                                    or string.find(o, "dish")
                                    or string.find(o, "dirty")
                                    or string.find(o, "plate") then

                                    washPrompt = pd
                                    break
                                end
                            end
                        end

                        if not washPrompt then
                            break
                        end

                        local promptParent = washPrompt.Parent

                        if not promptParent or not promptParent:IsA("BasePart") then
                            break
                        end

                        local release3 = acquireTp()

                        tp(
                            promptParent.CFrame
                            * CFrame.new(0, 3, 0)
                        )

                        task.wait(0.6)

                        -- Start the hold without checking camera visibility.
                        local holdStart = os.clock()
                        local holdActive = false

                        while washPrompt
                            and washPrompt.Parent
                            and washPrompt.Enabled
                            and os.clock() - holdStart < 6 do

                            if not holdActive then
                                local ok = pcall(function()
                                    washPrompt:InputHoldBegin()
                                end)

                                if ok then
                                    holdActive = true
                                end
                            end

                            task.wait(0.1)

                            -- Re-issue InputHoldBegin if the hold gets interrupted.
                            if holdActive
                                and washPrompt.Parent
                                and washPrompt.Enabled then

                                pcall(function()
                                    washPrompt:InputHoldBegin()
                                end)
                            else
                                holdActive = false
                            end
                        end

                        -- Always end the hold.
                        pcall(function()
                            if washPrompt and washPrompt.Parent then
                                washPrompt:InputHoldEnd()
                            end
                        end)

                        holdActive = false

                        release3()

                        washed = washed + 1

                        task.wait(0.5)
                    end
                end

                if washed > 0 then
                    setStatus(
                        "wash",
                        "Washed " .. washed .. " dishes"
                    )
                else
                    setStatus(
                        "wash",
                        "Nothing to wash"
                    )
                end
            end
        else
            setStatus("wash", "Disabled")
        end

        task.wait(cfg.washDelay)
    end
end)

-- SHOP - INGREDIENTS

local IngredientStats = {}
local ingredientNames = {}
local ingredientBusy = {}

local autoBuyThreshold = 10
local autoBuyEnabled = false

for ingredientName, data in pairs(IngredientsConfig) do
    if type(data) == "table" and data.Cost then
        table.insert(ingredientNames, ingredientName)
    end
end

table.sort(ingredientNames, function(a, b)
    return tostring(a):lower() < tostring(b):lower()
end)

local function getIngredientStock(ingredientName)
    local ingredients = LocalPlayer:FindFirstChild("Ingredients")
    if not ingredients then
        return 0
    end

    local stock = ingredients:FindFirstChild(ingredientName)
    if not stock then
        return 0
    end

    return tonumber(stock.Value) or 0
end

local function getIngredientMax(ingredientName)
    local config = IngredientsConfig[ingredientName]

    if not config then
        return 100
    end

    return tonumber(
        config.MaxStock
        or config.Max
        or config.Capacity
        or config.Limit
    ) or 100
end

local function getIngredientPercent(ingredientName)
    local stock = getIngredientStock(ingredientName)
    local maxStock = getIngredientMax(ingredientName)

    if maxStock <= 0 then
        return 0
    end

    return math.clamp((stock / maxStock) * 100, 0, 100)
end

local function buyIngredientOnce(ingredientName)
    if ingredientBusy[ingredientName] then
        return false
    end

    local config = IngredientsConfig[ingredientName]

    if not config or not config.Cost then
        setStatus("buyIng", "Invalid ingredient: " .. tostring(ingredientName))
        return false
    end

    local cost = tonumber(config.Cost)

    if not cost then
        setStatus("buyIng", "Invalid cost: " .. tostring(ingredientName))
        return false
    end

    local stock = getIngredientStock(ingredientName)
    local maxStock = getIngredientMax(ingredientName)

    if stock >= maxStock then
        setStatus(
            "buyIng",
            string.format(
                "%s full (%d/%d)",
                tostring(ingredientName),
                stock,
                maxStock
            )
        )
        return false
    end

    local cashBefore = getCash()

    if cashBefore - cost < 5000 then
        setStatus("buyIng", "Keeping $5000 reserve")
        return false
    end

    ingredientBusy[ingredientName] = true

    local ok, result = pcall(function()
        return BuyIngredient:InvokeServer(
            ingredientName,
            1,
            "Cash"
        )
    end)

    task.wait(0.15)

    local cashAfter = getCash()
    local spent = cashAfter - cashBefore

    if spent ~= 0 then
        logMoney(
            "Buy " .. tostring(ingredientName),
            spent
        )
    end

    ingredientBusy[ingredientName] = nil

    if ok and result ~= false then
        local newStock = getIngredientStock(ingredientName)

        setStatus(
            "buyIng",
            string.format(
                "Bought %s (%d/%d)",
                tostring(ingredientName),
                newStock,
                maxStock
            )
        )

        return true
    end

    setStatus(
        "buyIng",
        "Failed to buy " .. tostring(ingredientName)
    )

    return false
end

