-- AUTO PAN
task.spawn(function()
    while true do
        if cfg.autoPan then
            local char, hum = getChar()
            if char and hum then
                local bp = LocalPlayer:FindFirstChild("Backpack")
                local pan = bp and bp:FindFirstChild("Pan") or char:FindFirstChild("Pan")
                if not pan then
                    setStatus("pan", "No pan equipped")
                else
                    local chased = false
                    local hitCount = 0

                    while cfg.autoPan do
                        local cn = Workspace:FindFirstChild("ClientNPCs")
                        local runawayNPC = nil

                        if cn then
                            for _, npc in ipairs(cn:GetChildren()) do
                                if npc.Parent
                                    and npc:IsA("Model")
                                    and npc:GetAttribute("IsRunaway") == true
                                    and isMyRunaway(npc) then

                                    runawayNPC = npc
                                    break
                                end
                            end
                        end

                        -- No runaway = task finished, auto-unequip once
                        if not runawayNPC then
                            if pan.Parent == char then
                                hum:UnequipTools()
                            end

                            if chased then
                                setStatus("pan", "Done!")
                            else
                                setStatus("pan", "No my runaways")
                            end

                            break
                        end

                        local nh = runawayNPC:FindFirstChild("HumanoidRootPart")
                            or runawayNPC.PrimaryPart

                        if not nh then
                            task.wait(0.1)
                            continue
                        end

                        chased = true
                        hitCount = hitCount + 1
                        setStatus("pan", "Attacking... (" .. hitCount .. ")")

                        -- Only auto-equip when there is an actual runaway
                        if pan.Parent ~= char then
                            hum:EquipTool(pan)
                            task.wait(0.1)
                        end

                        local release = acquireTp()

                        tp(nh.CFrame * CFrame.new(0, 0, -1.8))

                        if pan.Parent == char then
                            pcall(function()
                                pan:Activate()
                            end)
                        end

                        release()

                        task.wait(0.1)
                    end
                end
            end
        else
            -- Don't force unequip when AutoPan is disabled.
            setStatus("pan", "Disabled")
        end

        task.wait(0.5)
    end
end)

